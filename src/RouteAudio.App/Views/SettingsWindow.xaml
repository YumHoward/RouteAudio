<Window x:Class="RouteAudio.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置"
        Width="460" Height="380"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource WindowBackgroundBrush}"
        FontFamily="Microsoft YaHei UI, Segoe UI">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="设置" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,14" />

        <StackPanel Grid.Row="1" Margin="0,0,0,12">
            <CheckBox x:Name="StartWithWindowsCheck" Content="随 Windows 启动" Margin="0,4" />
            <CheckBox x:Name="MinimizeToTrayCheck" Content="关闭窗口时最小化到托盘" Margin="0,4" />
            <CheckBox x:Name="NotifyCheck" Content="路由异常时显示通知" Margin="0,4" />
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,4,0,12">
            <TextBlock Text="对账间隔（秒）" VerticalAlignment="Center" />
            <TextBox x:Name="ReconcileBox" Width="60" Margin="10,0,0,0" Height="26"
                     VerticalContentAlignment="Center" />
            <TextBlock Text="1–60；越小越灵敏，开销越大" Margin="10,0,0,0" FontSize="11"
                       Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
        </StackPanel>

        <StackPanel Grid.Row="3" Margin="0,0,0,12">
            <TextBlock Text="配置文件" FontWeight="SemiBold" />
            <TextBlock x:Name="ConfigPathText" FontSize="11" TextWrapping="Wrap"
                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,6" />
            <Button Content="打开配置文件夹" Width="130" HorizontalAlignment="Left"
                    Style="{StaticResource ActionButton}" Click="OpenConfig_Click" />
        </StackPanel>

        <StackPanel Grid.Row="4">
            <TextBlock Text="音频后端" FontWeight="SemiBold" />
            <TextBlock x:Name="BackendText" FontSize="12" Margin="0,4,0,0"
                       Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
            <TextBlock x:Name="VirtualCableText" FontSize="12" Margin="0,6,0,0"
                       Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="保存" Width="90" Style="{StaticResource ActionButton}" Click="Save_Click" />
            <Button Content="取消" Width="90" Margin="8,0,0,0" Style="{StaticResource ActionButton}" Click="Cancel_Click" />
        </StackPanel>
    </Grid>
</Window>
