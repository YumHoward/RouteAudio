<Window x:Class="RouteAudio.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RouteAudio · 声路由"
        Width="1080" Height="700"
        MinWidth="900" MinHeight="560"
        Background="{StaticResource WindowBackgroundBrush}"
        WindowStartupLocation="CenterScreen"
        FontFamily="Microsoft YaHei UI, Segoe UI">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 顶部工具栏 -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="RouteAudio" FontSize="22" FontWeight="SemiBold" />
                <TextBlock Text="把每个应用的声音送到你想去的设备"
                           Margin="14,6,0,0" FontSize="12"
                           Foreground="{StaticResource TextSecondaryBrush}" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="配置档" VerticalAlignment="Center" Margin="0,0,8,0"
                           Foreground="{StaticResource TextSecondaryBrush}" />
                <ComboBox ItemsSource="{Binding Profiles}"
                          SelectedItem="{Binding SelectedProfile}"
                          DisplayMemberPath="Name"
                          Width="150" Height="30" VerticalContentAlignment="Center" />
                <Button Content="刷新" Command="{Binding RefreshCommand}"
                        Style="{StaticResource ActionButton}" Margin="10,0,0,0" />
                <Button Content="全部清除" Command="{Binding ClearAllCommand}"
                        Style="{StaticResource ActionButton}" Margin="8,0,0,0" />
                <Button Content="设置" Command="{Binding SettingsCommand}"
                        Style="{StaticResource ActionButton}" Margin="8,0,0,0" />
            </StackPanel>
        </Grid>

        <!-- 主体 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="370" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左：正在播放 -->
            <Border Grid.Column="0" Style="{StaticResource CardBorder}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="正在播放"
                               FontSize="15" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <TextBlock DockPanel.Dock="Top"
                               Text="拖拽应用到右侧设备即可路由"
                               FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,0,0,10" />

                    <ListBox x:Name="AppsList"
                             ItemsSource="{Binding RunningApps}"
                             BorderThickness="0" Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             PreviewMouseLeftButtonDown="AppsList_PreviewMouseLeftButtonDown"
                             PreviewMouseMove="AppsList_PreviewMouseMove">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="10" Margin="0,3" Background="#F9FAFB"
                                        CornerRadius="8" BorderBrush="{StaticResource BorderBrushSoft}"
                                        BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="34" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Border Width="28" Height="28" Background="{StaticResource AccentBrush}"
                                                CornerRadius="6" VerticalAlignment="Top">
                                            <TextBlock Text="{Binding Initial}" Foreground="White"
                                                       FontWeight="Bold" FontSize="13"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>

                                        <StackPanel Grid.Column="1" Margin="10,0,6,0">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding CurrentDeviceName}" FontSize="11"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding StateText}" FontSize="11"
                                                       Foreground="{Binding StateBrush}"
                                                       HorizontalAlignment="Right" />
                                            <TextBlock Text="{Binding DesiredDeviceName, StringFormat=→ {0}}"
                                                       FontSize="10"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       HorizontalAlignment="Right"
                                                       TextTrimming="CharacterEllipsis" MaxWidth="110" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- 右：设备通道 -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <ItemsControl ItemsSource="{Binding Lanes}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12"
                                        AllowDrop="True" Tag="{Binding}"
                                        DragOver="Lane_DragOver" Drop="Lane_Drop">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" />
                                                <Border Background="#EEF2FF" CornerRadius="4" Padding="6,1"
                                                        Margin="8,2,0,0"
                                                        Visibility="{Binding IsDefault, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="默认" FontSize="10"
                                                               Foreground="{StaticResource AccentBrush}" />
                                                </Border>
                                                <Border Background="#FEF3C7" CornerRadius="4" Padding="6,1"
                                                        Margin="6,2,0,0"
                                                        Visibility="{Binding IsVirtual, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="虚拟" FontSize="10"
                                                               Foreground="{StaticResource WarningBrush}" />
                                                </Border>
                                            </StackPanel>

                                            <TextBlock Grid.Column="1" Text="{Binding Subtitle}" FontSize="11"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       VerticalAlignment="Center" />
                                        </Grid>

                                        <ItemsControl ItemsSource="{Binding Routes}" Margin="0,8,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="#F9FAFB" CornerRadius="6" Padding="8,6"
                                                            Margin="0,3" BorderBrush="#E5E7EB" BorderThickness="1">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>

                                                            <TextBlock Text="{Binding AppName}" FontWeight="SemiBold"
                                                                       TextTrimming="CharacterEllipsis" />

                                                            <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                                        VerticalAlignment="Center" Margin="8,0">
                                                                <TextBlock Text="{Binding StateText}" FontSize="11"
                                                                           Foreground="{Binding StateBrush}" />
                                                                <TextBlock Text="{Binding ReasonText}" FontSize="10"
                                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                                           Margin="6,0,0,0" />
                                                            </StackPanel>

                                                            <Button Grid.Column="2" Content="✕" Width="22" Height="22"
                                                                    FontSize="10" Padding="0" Cursor="Hand"
                                                                    ToolTip="取消路由"
                                                                    Click="Unroute_Click" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- 按角色路由 -->
                    <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12"
                            Visibility="{Binding HasRoleTargets, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="按设备角色路由" FontSize="15" FontWeight="SemiBold" />
                            <ItemsControl ItemsSource="{Binding RoleTargets}" Margin="0,8,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#F9FAFB" CornerRadius="6" Padding="8,6"
                                                Margin="0,3" BorderBrush="#E5E7EB" BorderThickness="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding AppName}" FontWeight="SemiBold" />
                                                <TextBlock Grid.Column="1" Text="{Binding StateText}" FontSize="11"
                                                           Foreground="{Binding StateBrush}" Margin="8,0" />
                                                <Button Grid.Column="2" Content="✕" Width="22" Height="22"
                                                        FontSize="10" Padding="0" Click="Unroute_Click"
                                                        ToolTip="取消路由" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- 状态栏 -->
        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding StatusText}" FontSize="12"
                           Foreground="{StaticResource TextSecondaryBrush}" />
                <TextBlock Text="{Binding LastError}" FontSize="12" Margin="12,0,0,0"
                           Foreground="{StaticResource DangerBrush}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <TextBlock Text="{Binding BackendText}" FontSize="12"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           ToolTip="{Binding VirtualCableHint}" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
