<Window x:Class="RouteAudio.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:RouteAudio.App.Converters"
        Title="RouteAudio · 声路由"
        Icon="/Assets/app.ico"
        Width="1160" Height="748"
        MinWidth="900" MinHeight="540"
        Background="{StaticResource WindowBackgroundBrush}"
        WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource AppFont}">

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:StringEmptyToVisibilityConverter x:Key="EmptyToVisible" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ================= 顶部 ================= -->
        <Border Grid.Row="0" Background="{StaticResource CardBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="0,0,0,1"
                Padding="20,13">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal">
                    <Border Width="38" Height="38" CornerRadius="11" Background="{StaticResource AccentBrush}">
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE767;" Foreground="White" FontSize="19" />
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="RouteAudio" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="把每个应用的声音送到指定的输出设备"
                                   FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,1,0,0" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="配置档" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox Width="152" ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}"
                              DisplayMemberPath="Name" Style="{StaticResource ComboBoxSoft}" />
                    <Border Width="1" Height="22" Background="{StaticResource BorderBrushSoft}" Margin="14,0" />
                    <Button Style="{StaticResource IconButton}" Click="Refresh_Click" ToolTip="立即刷新（重新对账）">
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE72C;" FontSize="16" />
                    </Button>
                    <Button Style="{StaticResource IconButton}" Click="Rules_Click" ToolTip="规则与配置档">
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE8FD;" FontSize="16" />
                    </Button>
                    <Button Style="{StaticResource IconButton}" Click="Settings_Click" ToolTip="设置">
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE713;" FontSize="16" />
                    </Button>
                    <Button Style="{StaticResource IconButton}" Click="ClearAll_Click" ToolTip="清除当前配置档的全部路由">
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE74D;" FontSize="15" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= 主体 ================= -->
        <Grid Grid.Row="1" Margin="20,18,20,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="392" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左：正在播放 -->
            <Border Grid.Column="0" Style="{StaticResource CardBorder}" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="正在播放" FontSize="15" FontWeight="SemiBold" />
                            <Border Background="{StaticResource AccentSoftBrush}" CornerRadius="9" Padding="8,2" Margin="8,1,0,0">
                                <TextBlock Text="{Binding Apps.Count}" FontSize="11"
                                           Foreground="{StaticResource AccentBrush}" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="拖拽到右侧设备" HorizontalAlignment="Right" VerticalAlignment="Center"
                                   FontSize="11" Foreground="{StaticResource TextTertiaryBrush}" />
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,12,0,10">
                        <TextBox x:Name="SearchBox" Style="{StaticResource SearchBox}" TextChanged="Search_TextChanged" />
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE721;" FontSize="13"
                                   HorizontalAlignment="Left" Margin="10,0,0,0"
                                   Foreground="{StaticResource TextTertiaryBrush}" IsHitTestVisible="False" />
                        <TextBlock Text="搜索应用…" FontSize="12" Margin="30,0,0,0" VerticalAlignment="Center"
                                   Foreground="{StaticResource TextTertiaryBrush}" IsHitTestVisible="False"
                                   Visibility="{Binding Text, ElementName=SearchBox, Converter={StaticResource EmptyToVisible}}" />
                    </Grid>

                    <Grid Grid.Row="2">
                        <ListBox x:Name="AppsList" Style="{StaticResource PlainListBox}"
                                 ItemsSource="{Binding Apps}"
                                 PreviewMouseLeftButtonDown="AppsList_PreviewMouseLeftButtonDown"
                                 PreviewMouseMove="AppsList_PreviewMouseMove">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="10" Margin="0,0,0,6" Padding="10"
                                            BorderThickness="1" Cursor="Hand"
                                            ToolTip="{Binding CurrentDeviceName, StringFormat=当前输出：{0}}">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
                                                <Setter Property="BorderBrush" Value="#EDF0F4" />
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource HoverBrush}" />
                                                        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <Border Width="34" Height="34" CornerRadius="9"
                                                    Background="{StaticResource AccentSoftBrush}">
                                                <TextBlock Text="{Binding Initial}" FontSize="14" FontWeight="Bold"
                                                           Foreground="{StaticResource AccentBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>

                                            <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding CurrentDeviceName}" FontSize="11"
                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                           TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                <Border Background="{Binding StatusBackground}" CornerRadius="6"
                                                        Padding="8,3" HorizontalAlignment="Right">
                                                    <TextBlock Text="{Binding StateText}" FontSize="11"
                                                               Foreground="{Binding StatusForeground}" />
                                                </Border>
                                                <TextBlock Text="{Binding RouteHint}" FontSize="10"
                                                           Foreground="{StaticResource TextTertiaryBrush}"
                                                           HorizontalAlignment="Right" Margin="0,3,0,0"
                                                           TextTrimming="CharacterEllipsis" MaxWidth="130" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                    Visibility="{Binding IsEmptyApps, Converter={StaticResource BoolToVis}}">
                            <TextBlock Style="{StaticResource IconText}" Text="&#xE7F5;" FontSize="30"
                                       Foreground="{StaticResource TextTertiaryBrush}" />
                            <TextBlock Text="{Binding EmptyStateText}" FontSize="12" TextAlignment="Center"
                                       Foreground="{StaticResource TextTertiaryBrush}" Margin="0,10,0,0"
                                       LineHeight="20" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- 右：设备通道 -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled" Padding="0,0,6,0">
                <StackPanel>
                    <Grid Margin="2,0,2,10">
                        <TextBlock Text="输出设备" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock Text="每个设备可单独调节音量、静音"
                                   HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11"
                                   Foreground="{StaticResource TextTertiaryBrush}" />
                    </Grid>

                    <ItemsControl ItemsSource="{Binding Lanes}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border AllowDrop="True" Tag="{Binding}"
                                        DragOver="Lane_DragOver" Drop="Lane_Drop" DragLeave="Lane_DragLeave"
                                        Padding="14" Margin="0,0,0,12">
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource CardBorder}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDropTarget}" Value="True">
                                                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                                    <Setter Property="BorderThickness" Value="2" />
                                                    <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>

                                    <Border.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="重命名设备…" Click="RenameDevice_Click" />
                                            <MenuItem Header="刷新" Click="RefreshLane_Click" />
                                        </ContextMenu>
                                    </Border.ContextMenu>

                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <Border Width="34" Height="34" CornerRadius="9"
                                                    Background="{StaticResource SurfaceBrush}">
                                                <TextBlock Style="{StaticResource IconText}" Text="{Binding IconGlyph}"
                                                           FontSize="16" Foreground="{StaticResource AccentBrush}" />
                                            </Border>

                                            <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" />
                                                    <Border Background="{StaticResource AccentSoftBrush}" CornerRadius="4"
                                                            Padding="6,1" Margin="6,1,0,0"
                                                            Visibility="{Binding IsDefault, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Text="默认" FontSize="10"
                                                                   Foreground="{StaticResource AccentBrush}" />
                                                    </Border>
                                                    <Border Background="{StaticResource WarningSoftBrush}" CornerRadius="4"
                                                            Padding="6,1" Margin="6,1,0,0"
                                                            Visibility="{Binding IsVirtual, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Text="虚拟" FontSize="10"
                                                                   Foreground="{StaticResource WarningBrush}" />
                                                    </Border>
                                                    <Border Background="{StaticResource NeutralSoftBrush}" CornerRadius="4"
                                                            Padding="6,1" Margin="6,1,0,0"
                                                            Visibility="{Binding IsCommunicationsDefault, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Text="通信" FontSize="10"
                                                                   Foreground="{StaticResource TextSecondaryBrush}" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Subtitle}" FontSize="11"
                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                           Margin="0,2,0,0" />
                                            </StackPanel>

                                        </Grid>

                                        <!-- 设备音量 -->
                                        <Grid Margin="0,10,0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <Button Style="{StaticResource IconButton}" Width="30" Height="30"
                                                    Click="Mute_Click" ToolTip="{Binding MuteTooltip}">
                                                <TextBlock Style="{StaticResource IconText}" Text="{Binding MuteGlyph}"
                                                           FontSize="14" Foreground="{StaticResource TextSecondaryBrush}" />
                                            </Button>

                                            <Slider Grid.Column="1" Style="{StaticResource VolumeSlider}"
                                                    Minimum="0" Maximum="100"
                                                    Value="{Binding VolumePercent, Mode=TwoWay}"
                                                    ValueChanged="Volume_ValueChanged" Margin="6,0"
                                                    AutomationProperties.Name="{Binding Title, StringFormat=音量 {0}}"
                                                    ToolTip="设备总音量（影响该设备上的所有声音）" />

                                            <TextBlock Grid.Column="2" Text="{Binding VolumeText}" FontSize="11"
                                                       Foreground="{StaticResource TextTertiaryBrush}" Width="38"
                                                       TextAlignment="Right" VerticalAlignment="Center" />
                                        </Grid>

                                        <!-- 已路由的应用 -->
                                        <ItemsControl ItemsSource="{Binding Routes}" Margin="0,6,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{StaticResource SurfaceBrush}" CornerRadius="8"
                                                            Padding="9,6" Margin="0,0,0,4">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>

                                                            <StackPanel VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding AppName}" FontSize="12"
                                                                           FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Text="{Binding ReasonText}" FontSize="10"
                                                                           Foreground="{StaticResource TextTertiaryBrush}"
                                                                           TextTrimming="CharacterEllipsis" />
                                                            </StackPanel>

                                                            <Border Grid.Column="1" Background="{Binding StatusBackground}"
                                                                    CornerRadius="6" Padding="7,2" Margin="8,0"
                                                                    VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding StateText}" FontSize="10"
                                                                           Foreground="{Binding StatusForeground}" />
                                                            </Border>

                                                            <Button Grid.Column="2" Style="{StaticResource IconButton}"
                                                                    Width="26" Height="26" Click="Unroute_Click"
                                                                    ToolTip="取消路由">
                                                                <TextBlock Style="{StaticResource IconText}" Text="&#xE711;"
                                                                           FontSize="10" />
                                                            </Button>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- 空状态拖放区 -->
                                        <Grid Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}"
                                              Margin="0,8,0,0" Height="40">
                                            <Rectangle RadiusX="9" RadiusY="9" Fill="{StaticResource SurfaceBrush}"
                                                       Stroke="#D6DDE7" StrokeThickness="1"
                                                       StrokeDashArray="4 3" />
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                                        VerticalAlignment="Center">
                                                <TextBlock Style="{StaticResource IconText}" Text="&#xE72A;" FontSize="11"
                                                           Foreground="{StaticResource TextTertiaryBrush}" />
                                                <TextBlock Text="把应用拖到这里" FontSize="11" Margin="6,0,0,0"
                                                           Foreground="{StaticResource TextTertiaryBrush}" />
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- 按角色路由 -->
                    <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12" Padding="14"
                            Visibility="{Binding HasRoleTargets, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="按设备角色路由" FontSize="14" FontWeight="SemiBold" />
                            <TextBlock Text="这些应用跟随系统对应的默认设备（主设备 / 多媒体 / 通信）"
                                       FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,8" />
                            <ItemsControl ItemsSource="{Binding RoleTargets}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource SurfaceBrush}" CornerRadius="8"
                                                Padding="9,6" Margin="0,0,0,4">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding AppName}" FontSize="12" FontWeight="SemiBold"
                                                           VerticalAlignment="Center" />
                                                <Border Grid.Column="1" Background="{Binding StatusBackground}"
                                                        CornerRadius="6" Padding="7,2" Margin="8,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding StateText}" FontSize="10"
                                                               Foreground="{Binding StatusForeground}" />
                                                </Border>
                                                <Button Grid.Column="2" Style="{StaticResource IconButton}"
                                                        Width="26" Height="26" Click="Unroute_Click" ToolTip="取消路由">
                                                    <TextBlock Style="{StaticResource IconText}" Text="&#xE711;" FontSize="10" />
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ================= 状态栏 ================= -->
        <Border Grid.Row="2" Background="{StaticResource CardBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="0,1,0,0"
                Padding="20,9">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="7" Height="7" Fill="{StaticResource SuccessBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="已生效" FontSize="11" Margin="6,0,4,0" Foreground="{StaticResource TextSecondaryBrush}" />
                    <TextBlock Text="{Binding HealthyCount}" FontSize="11" FontWeight="SemiBold" Margin="0,0,14,0" />

                    <Ellipse Width="7" Height="7" Fill="{StaticResource WarningBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="等待" FontSize="11" Margin="6,0,4,0" Foreground="{StaticResource TextSecondaryBrush}" />
                    <TextBlock Text="{Binding PendingCount}" FontSize="11" FontWeight="SemiBold" Margin="0,0,14,0" />

                    <Ellipse Width="7" Height="7" Fill="{StaticResource DangerBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="异常" FontSize="11" Margin="6,0,4,0" Foreground="{StaticResource TextSecondaryBrush}" />
                    <TextBlock Text="{Binding FailedCount}" FontSize="11" FontWeight="SemiBold" Margin="0,0,14,0" />

                    <TextBlock Text="{Binding StatusText}" FontSize="11"
                               Foreground="{StaticResource TextTertiaryBrush}" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding LastError}" FontSize="11" Foreground="{StaticResource DangerBrush}"
                               Margin="0,0,14,0" TextTrimming="CharacterEllipsis" MaxWidth="360" />
                    <TextBlock Text="{Binding BackendText}" FontSize="11"
                               Foreground="{StaticResource TextTertiaryBrush}" ToolTip="{Binding VirtualCableHint}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
