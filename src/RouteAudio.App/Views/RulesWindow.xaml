<Window x:Class="RouteAudio.App.Views.RulesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="规则与配置档"
        Width="920" Height="640"
        MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBackgroundBrush}"
        FontFamily="Microsoft YaHei UI, Segoe UI">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 配置档 -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="配置档" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
            <ComboBox x:Name="ProfileBox" Grid.Column="1" Margin="10,0,0,0" Height="28"
                      DisplayMemberPath="Name" VerticalContentAlignment="Center"
                      SelectionChanged="ProfileBox_SelectionChanged" />
            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="新建" Width="64" Style="{StaticResource ActionButton}" Click="NewProfile_Click" />
                <Button Content="复制" Width="64" Margin="6,0,0,0" Style="{StaticResource ActionButton}" Click="CopyProfile_Click" />
                <Button Content="重命名" Width="76" Margin="6,0,0,0" Style="{StaticResource ActionButton}" Click="RenameProfile_Click" />
                <Button Content="删除" Width="64" Margin="6,0,0,0" Style="{StaticResource ActionButton}" Click="DeleteProfile_Click" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,6">
            <TextBlock Text="规则（优先级大者优先；同优先级时条件更具体者优先）"
                       FontSize="14" FontWeight="SemiBold" />
            <TextBlock x:Name="RuleCountText" HorizontalAlignment="Right" FontSize="11"
                       Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
        </Grid>

        <ListView Grid.Row="2" x:Name="RulesList" ItemsSource="{Binding RuleRows}"
                  MouseDoubleClick="RulesList_MouseDoubleClick"
                  BorderBrush="{StaticResource BorderBrushSoft}">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="启用" Width="50">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding Enabled, Mode=TwoWay}"
                                          Click="RuleEnabled_Click" HorizontalAlignment="Center" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="优先级" Width="64" DisplayMemberBinding="{Binding Priority}" />
                    <GridViewColumn Header="名称" Width="170" DisplayMemberBinding="{Binding Name}" />
                    <GridViewColumn Header="条件" Width="300" DisplayMemberBinding="{Binding MatchText}" />
                    <GridViewColumn Header="动作" Width="260" DisplayMemberBinding="{Binding ActionText}" />
                </GridView>
            </ListView.View>
        </ListView>

        <Grid Grid.Row="3" Margin="0,10,0,14">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button Content="+ 添加规则" Width="100" Style="{StaticResource ActionButton}" Click="AddRule_Click" />
                <Button Content="编辑" Width="64" Margin="6,0,0,0" Style="{StaticResource ActionButton}" Click="EditRule_Click" />
                <Button Content="删除" Width="64" Margin="6,0,0,0" Style="{StaticResource ActionButton}" Click="DeleteRule_Click" />
            </StackPanel>
            <Button Content="关闭" Width="80" HorizontalAlignment="Right"
                    Style="{StaticResource ActionButton}" Click="Close_Click" />
        </Grid>

        <!-- 测试器 -->
        <Border Grid.Row="4" Style="{StaticResource CardBorder}">
            <StackPanel>
                <TextBlock Text="规则测试器" FontSize="13" FontWeight="SemiBold" />
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <TextBlock Text="选择一个正在运行的应用：" VerticalAlignment="Center" FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}" />
                    <ComboBox x:Name="AppBox" Width="280" Height="28" Margin="10,0,0,0"
                              DisplayMemberPath="App.DisplayName" VerticalContentAlignment="Center" />
                    <Button Content="测试" Width="72" Margin="10,0,0,0"
                            Style="{StaticResource ActionButton}" Click="TestRule_Click" />
                </StackPanel>
                <TextBlock x:Name="TestResultText" Margin="0,8,0,0" FontSize="12" TextWrapping="Wrap"
                           Foreground="{StaticResource TextSecondaryBrush}" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
